// Management-plane operations that read or change APIM secrets/keys.
// Table: AzureActivity (Activity log -> Log Analytics). Set {lookback} e.g. 90d.
AzureActivity
| where TimeGenerated > ago({lookback})
| where ResourceProviderValue =~ "MICROSOFT.APIMANAGEMENT"
| where OperationNameValue has_any ("listValue", "listSecrets", "listKeys",
        "tenant/access", "gitAccess", "regeneratePrimaryKey", "regenerateSecondaryKey",
        "namedValues/write", "subscriptions/write", "users/write", "identityProviders/write")
| summarize Count = count(), First = min(TimeGenerated), Last = max(TimeGenerated)
    by Caller, CallerIpAddress, OperationNameValue, ActivityStatusValue, _ResourceId
| order by Last desc
