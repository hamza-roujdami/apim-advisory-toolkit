// LAB ONLY - deploys two Classic (Developer tier) APIM instances seeded with the
// risky settings apimtk is meant to find, plus a Key Vault for the fix path and a
// Basic Event Hubs namespace for a connection-string logger.
// All "keys" are random GUID-derived strings generated at deploy time - not real credentials.
//
//   az group create -n rg-apimtk-lab -l uaenorth
//   az deployment group create -g rg-apimtk-lab -f lab/seed.bicep -p publisherEmail=<you@contoso.com>
//
// Provisioning takes ~30-45 min per instance (they deploy in parallel). Delete the RG when done.

targetScope = 'resourceGroup'

@description('Publisher email required by APIM')
param publisherEmail string

param location string = resourceGroup().location
param prefix string = 'apimtk'

@description('Fake key material - generated per deployment, never a real credential')
@secure()
param fakeKey1 string = replace(newGuid(), '-', '')
@secure()
param fakeKey2 string = replace(newGuid(), '-', '')
@secure()
param fakeKey3 string = replace(newGuid(), '-', '')

@description('Optional self-signed client certificate (base64 PFX), generated by run-lab.sh. Empty = skip the certificate scenario.')
@secure()
param clientCertPfx string = ''
@secure()
param clientCertPassword string = ''

@description('Deploy the Event Hubs logger scenario. Set false where Azure Policy forces disableLocalAuth on Event Hubs (the logger needs a SAS connection string).')
param deployEventHubLogger bool = true

@description('Also deploy a Consumption-tier instance (not affected by the advisory) to check it is excluded')
param deployConsumption bool = true

var suffix = uniqueString(resourceGroup().id)
var keyVaultSecretsUser = '4633458b-17de-408a-b874-0445c86b69e6'

// ---------------------------------------------------------------- Key Vault
resource kv 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: 'kv-${prefix}-${take(suffix, 8)}'
  location: location
  properties: {
    tenantId: subscription().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    enableSoftDelete: true
    softDeleteRetentionInDays: 7
  }
}

resource kvLlm 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: kv
  name: 'llm-api-key'
  properties: { value: fakeKey3 }
}

// target secret used later by: apimtk remediate --action link-keyvault --named-value gpt-api-key
resource kvGpt 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: kv
  name: 'gpt-api-key'
  properties: { value: 'rotated-${fakeKey2}' }
}

// ---------------------------------------------------------------- Instance A
// Has managed identity, a mix of named value types, legacy mgmt API ON, sign-up ON,
// self-service product without approval, an app subscription.
resource apimA 'Microsoft.ApiManagement/service@2022-08-01' = {
  name: '${prefix}-lab-a-${take(suffix, 6)}'
  location: location
  sku: { name: 'Developer', capacity: 1 }
  identity: { type: 'SystemAssigned' }
  properties: {
    publisherEmail: publisherEmail
    publisherName: 'apimtk lab'
  }
}

resource kvRoleA 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(kv.id, apimA.id, keyVaultSecretsUser)
  scope: kv
  properties: {
    principalId: apimA.identity.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', keyVaultSecretsUser)
  }
}

// CRITICAL: key-like value stored as plain text
resource nvPlainKey 'Microsoft.ApiManagement/service/namedValues@2022-08-01' = {
  parent: apimA
  name: 'embedding-api-key'
  properties: { displayName: 'embedding-api-key', secret: false, value: fakeKey1 }
}

// HIGH: secret stored inside APIM, referenced by a backend
resource nvSecret 'Microsoft.ApiManagement/service/namedValues@2022-08-01' = {
  parent: apimA
  name: 'gpt-api-key'
  properties: { displayName: 'gpt-api-key', secret: true, value: fakeKey2 }
}

// OK: Key Vault reference (versionless)
resource nvKv 'Microsoft.ApiManagement/service/namedValues@2022-08-01' = {
  parent: apimA
  name: 'llm-api-key'
  properties: {
    displayName: 'llm-api-key'
    secret: true
    keyVault: { secretIdentifier: '${kv.properties.vaultUri}secrets/llm-api-key' }
  }
  dependsOn: [ kvRoleA, kvLlm ]
}

// OK: config values that must NOT be flagged
resource nvTenant 'Microsoft.ApiManagement/service/namedValues@2022-08-01' = {
  parent: apimA
  name: 'tenant-id'
  properties: { displayName: 'tenant-id', secret: false, value: subscription().tenantId }
}

resource nvUrl 'Microsoft.ApiManagement/service/namedValues@2022-08-01' = {
  parent: apimA
  name: 'backend-url'
  properties: { displayName: 'backend-url', secret: false, value: 'https://backend.contoso.example/api' }
}

resource backendAoai 'Microsoft.ApiManagement/service/backends@2022-08-01' = {
  parent: apimA
  name: 'aoai'
  properties: {
    protocol: 'http'
    url: 'https://aoai.contoso.example/openai'
    credentials: { header: { 'api-key': [ '{{gpt-api-key}}' ] } }
  }
  dependsOn: [ nvSecret ]
}

// HIGH: legacy direct management API enabled
resource tenantAccessA 'Microsoft.ApiManagement/service/tenant@2022-08-01' = {
  parent: apimA
  name: 'access'
  properties: { enabled: true }
}

// MEDIUM: developer portal self sign-up enabled
resource signupA 'Microsoft.ApiManagement/service/portalsettings@2022-08-01' = {
  parent: apimA
  name: 'signup'
  properties: {
    enabled: true
    termsOfService: { enabled: false, consentRequired: false }
  }
}

// MEDIUM: published product, subscription required, no approval
resource productA 'Microsoft.ApiManagement/service/products@2022-08-01' = {
  parent: apimA
  name: 'ai-lab'
  properties: {
    displayName: 'AI lab'
    subscriptionRequired: true
    approvalRequired: false
    state: 'published'
  }
}

resource subA 'Microsoft.ApiManagement/service/subscriptions@2022-08-01' = {
  parent: apimA
  name: 'app-a'
  properties: {
    displayName: 'App A'
    scope: productA.id
    state: 'active'
  }
}

// CRITICAL: key written directly into the global policy
resource globalPolicyA 'Microsoft.ApiManagement/service/policies@2022-08-01' = {
  parent: apimA
  name: 'policy'
  properties: {
    format: 'xml'
    value: '<policies><inbound><set-header name="api-key" exists-action="override"><value>${fakeKey1}</value></set-header></inbound><backend><forward-request /></backend><outbound /><on-error /></policies>'
  }
}

// API whose policy uses {{gpt-api-key}} and whose operation has a password written into its policy
resource apiOrders 'Microsoft.ApiManagement/service/apis@2022-08-01' = {
  parent: apimA
  name: 'orders'
  properties: {
    displayName: 'Orders'
    path: 'orders'
    protocols: [ 'https' ]
    serviceUrl: 'https://backend.contoso.example/api'
    subscriptionRequired: true
  }
}

resource apiOrdersPolicy 'Microsoft.ApiManagement/service/apis/policies@2022-08-01' = {
  parent: apiOrders
  name: 'policy'
  properties: {
    format: 'xml'
    value: '<policies><inbound><base /><set-header name="api-key" exists-action="override"><value>{{gpt-api-key}}</value></set-header></inbound><backend><base /></backend><outbound><base /></outbound><on-error><base /></on-error></policies>'
  }
  dependsOn: [ nvSecret ]
}

resource opCreate 'Microsoft.ApiManagement/service/apis/operations@2022-08-01' = {
  parent: apiOrders
  name: 'create'
  properties: {
    displayName: 'Create order'
    method: 'POST'
    urlTemplate: '/orders'
  }
}

// CRITICAL: password written into an operation-level policy
resource opCreatePolicy 'Microsoft.ApiManagement/service/apis/operations/policies@2022-08-01' = {
  parent: opCreate
  name: 'policy'
  properties: {
    format: 'xml'
    value: '<policies><inbound><base /><authentication-basic username="svc-orders" password="${take(fakeKey2, 16)}" /></inbound><backend><base /></backend><outbound><base /></outbound><on-error><base /></on-error></policies>'
  }
}

// CRITICAL: key written directly into backend credentials
resource backendLegacy 'Microsoft.ApiManagement/service/backends@2022-08-01' = {
  parent: apimA
  name: 'legacy'
  properties: {
    protocol: 'http'
    url: 'https://legacy.contoso.example'
    credentials: { header: { 'x-api-key': [ fakeKey3 ] } }
  }
}

// HIGH: client secrets of a portal identity provider, an OAuth 2.0 server and an OpenID Connect provider
resource idpAad 'Microsoft.ApiManagement/service/identityProviders@2022-08-01' = {
  parent: apimA
  name: 'aad'
  properties: {
    clientId: '00000000-0000-0000-0000-00000000a0d1'
    clientSecret: fakeKey2
    allowedTenants: [ subscription().tenantId ]
    signinTenant: subscription().tenantId
    clientLibrary: 'MSAL-2'
  }
}

resource oauthServer 'Microsoft.ApiManagement/service/authorizationServers@2022-08-01' = {
  parent: apimA
  name: 'oauth-test-console'
  properties: {
    displayName: 'OAuth test console'
    clientRegistrationEndpoint: 'https://login.contoso.example/register'
    authorizationEndpoint: 'https://login.contoso.example/authorize'
    tokenEndpoint: 'https://login.contoso.example/token'
    authorizationMethods: [ 'GET' ]
    grantTypes: [ 'authorizationCode' ]
    clientAuthenticationMethod: [ 'Body' ]
    bearerTokenSendingMethods: [ 'authorizationHeader' ]
    clientId: 'apimtk-lab-oauth'
    clientSecret: fakeKey1
  }
}

resource oidcProvider 'Microsoft.ApiManagement/service/openidConnectProviders@2022-08-01' = {
  parent: apimA
  name: 'entra-oidc'
  properties: {
    displayName: 'Entra OIDC'
    metadataEndpoint: '${environment().authentication.loginEndpoint}common/v2.0/.well-known/openid-configuration'
    clientId: 'apimtk-lab-oidc'
    clientSecret: fakeKey3
  }
}

// MEDIUM (review changes): developer portal user registered at deploy time
resource userNew 'Microsoft.ApiManagement/service/users@2022-08-01' = {
  parent: apimA
  name: 'lab-new-user'
  properties: {
    email: 'lab-new-user@example.com'
    firstName: 'Lab'
    lastName: 'User'
    state: 'active'
  }
}

// HIGH: Event Hubs logger with a connection string
resource ehNamespace 'Microsoft.EventHub/namespaces@2024-01-01' = if (deployEventHubLogger) {
  name: 'evhns-${prefix}-${take(suffix, 8)}'
  location: location
  sku: { name: 'Basic', tier: 'Basic', capacity: 1 }
  properties: { disableLocalAuth: false } // the logger needs a SAS connection string; a Modify policy may override this
}

resource eventHub 'Microsoft.EventHub/namespaces/eventhubs@2024-01-01' = if (deployEventHubLogger) {
  parent: ehNamespace
  name: 'apim-logs'
  properties: { partitionCount: 1, messageRetentionInDays: 1 }
}

resource ehSendRule 'Microsoft.EventHub/namespaces/eventhubs/authorizationRules@2024-01-01' = if (deployEventHubLogger) {
  parent: eventHub
  name: 'apim-send'
  properties: { rights: [ 'Send' ] }
}

resource ehLogger 'Microsoft.ApiManagement/service/loggers@2022-08-01' = if (deployEventHubLogger) {
  parent: apimA
  name: 'eh-logger'
  properties: {
    loggerType: 'azureEventHub'
    credentials: {
      name: eventHub!.name
      connectionString: ehSendRule!.listKeys().primaryConnectionString
    }
  }
}

// CRITICAL: key written into a product policy
resource productAPolicy 'Microsoft.ApiManagement/service/products/policies@2022-08-01' = {
  parent: productA
  name: 'policy'
  properties: {
    format: 'xml'
    value: '<policies><inbound><base /><set-header name="x-partner-key" exists-action="override"><value>${fakeKey3}</value></set-header></inbound><backend><base /></backend><outbound><base /></outbound><on-error><base /></on-error></policies>'
  }
}

// CRITICAL: password written into a policy fragment
resource fragmentAuth 'Microsoft.ApiManagement/service/policyFragments@2022-08-01' = {
  parent: apimA
  name: 'legacy-auth'
  properties: {
    description: 'lab: password written into a fragment'
    format: 'xml'
    value: '<fragment><authentication-basic username="svc-legacy" password="${take(fakeKey1, 16)}" /></fragment>'
  }
}

// HIGH: Credential Manager provider with an OAuth client secret
resource credManagerGithub 'Microsoft.ApiManagement/service/authorizationProviders@2022-08-01' = {
  parent: apimA
  name: 'github'
  properties: {
    displayName: 'GitHub (lab)'
    identityProvider: 'github'
    oauth2: {
      grantTypes: {
        authorizationCode: {
          clientId: 'apimtk-lab-github'
          clientSecret: fakeKey2
          scopes: 'read:user'
        }
      }
    }
  }
}

// CRITICAL: Function key written into backend query credentials (backend URLs can't carry a query string),
// and a SAS signature written into an API service URL
resource backendFunc 'Microsoft.ApiManagement/service/backends@2022-08-01' = {
  parent: apimA
  name: 'func'
  properties: {
    protocol: 'http'
    url: 'https://func-contoso.example/api/run'
    credentials: { query: { code: [ fakeKey1 ] } }
  }
}

resource apiExport 'Microsoft.ApiManagement/service/apis@2022-08-01' = {
  parent: apimA
  name: 'export'
  properties: {
    displayName: 'Export'
    path: 'export'
    protocols: [ 'https' ]
    serviceUrl: 'https://stcontoso.blob.${environment().suffixes.storage}/exports?sv=2022-11-02&sp=r&sig=${fakeKey2}'
    subscriptionRequired: true
  }
}

// MEDIUM: certificate with private key uploaded to APIM, used by a backend for client auth
resource certClient 'Microsoft.ApiManagement/service/certificates@2022-08-01' = if (!empty(clientCertPfx)) {
  parent: apimA
  name: 'lab-client-cert'
  properties: {
    data: clientCertPfx
    password: clientCertPassword
  }
}

resource backendMtls 'Microsoft.ApiManagement/service/backends@2022-08-01' = if (!empty(clientCertPfx)) {
  parent: apimA
  name: 'mtls'
  properties: {
    protocol: 'http'
    url: 'https://mtls.contoso.example'
    credentials: { certificateIds: [ certClient.id ] }
  }
}

// ---------------------------------------------------------------- Instance B
// No managed identity, only secrets stored in APIM (secrets-only pattern).
resource apimB 'Microsoft.ApiManagement/service@2022-08-01' = {
  name: '${prefix}-lab-b-${take(suffix, 6)}'
  location: location
  sku: { name: 'Developer', capacity: 1 }
  properties: {
    publisherEmail: publisherEmail
    publisherName: 'apimtk lab'
  }
}

resource nvB1 'Microsoft.ApiManagement/service/namedValues@2022-08-01' = {
  parent: apimB
  name: 'llm-api-key-dev'
  properties: { displayName: 'llm-api-key-dev', secret: true, value: fakeKey1 }
}

resource nvB2 'Microsoft.ApiManagement/service/namedValues@2022-08-01' = {
  parent: apimB
  name: 'gpt-4o-api-key-LLM'
  properties: { displayName: 'gpt-4o-api-key-LLM', secret: true, value: fakeKey3 }
}

// ---------------------------------------------------------------- Instance C
// Consumption tier: Classic, but not affected by the advisory. apimtk must not inventory it.
resource apimC 'Microsoft.ApiManagement/service@2022-08-01' = if (deployConsumption) {
  name: '${prefix}-lab-c-${take(suffix, 6)}'
  location: location
  sku: { name: 'Consumption', capacity: 0 }
  properties: {
    publisherEmail: publisherEmail
    publisherName: 'apimtk lab'
  }
}

output apimAId string = apimA.id
output apimBId string = apimB.id
output keyVaultUri string = kv.properties.vaultUri
output gptSecretUri string = '${kv.properties.vaultUri}secrets/gpt-api-key'
